{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "github-workflows",
  "//": "Repository-local workflow routing, required contexts and Mac scheduling contracts. Test records uncached source-digested telemetry; budgets consumes that output.",
  "projectType": "library",
  "tags": [
    "type:tooling",
    "scope:ci"
  ],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/scripts/check-e2e-matrix.sh",
      "{workspaceRoot}/release-plz.toml",
      "{workspaceRoot}/justfile",
      "sharedGlobals",
      "{workspaceRoot}/scripts/dist.sh",
      "{workspaceRoot}/scripts/verify-release.sh",
      "{workspaceRoot}/scripts/install.sh",
      "{workspaceRoot}/rust-toolchain.toml"
    ]
  },
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node .github/tooling-run.mjs lint"
      },
      "inputs": [
        "default"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "default"
      ],
      "options": {
        "command": "node .github/tooling-run.mjs test"
      },
      "cache": false
    },
    "budgets": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "test"
      ],
      "cache": false,
      "inputs": [
        "{projectRoot}/**/*"
      ],
      "options": {
        "command": "node .github/tooling-run.mjs budgets"
      }
    }
  }
}
