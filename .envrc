# direnv environment for allowlister. Run `direnv allow` once to enable it
# (`just setup` and the Claude session hook do this for you).
#
# This layers the asdf-pinned `just` and the cargo/rustup toolchain onto PATH so
# the project's tools resolve to the versions this repo pins, without touching
# your global shell config.

# asdf-managed tools from .tool-versions (currently `just`). Prefer the
# asdf+direnv integration (`use asdf`, set up by `asdf direnv setup`) so versions
# load without spawning shims; fall back to putting the shims dir on PATH.
if has asdf; then
  if declare -F use_asdf >/dev/null 2>&1; then
    use asdf
  else
    PATH_add "${ASDF_DATA_DIR:-$HOME/.asdf}/shims"
  fi
fi

# rustup/cargo-installed binaries (rustc, cargo, cargo subcommands, lefthook,
# and a cargo-provided `just` if asdf is absent). rust-toolchain.toml pins the
# toolchain itself.
PATH_add "$HOME/.cargo/bin"

# Project scripts (setup.sh, e2e helpers) callable by bare name.
PATH_add scripts

# Machine-local, uncommitted overrides (never committed; see .gitignore).
dotenv_if_exists .env
